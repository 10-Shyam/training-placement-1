balance = 1000

print("1. Deposit")
print("2. Withdraw")

choice = int(input("Enter choice: "))

if choice == 1:
    amt = int(input("Enter amount: "))
    balance += amt
elif choice == 2:
    amt = int(input("Enter amount: "))
    if amt <= balance:
        balance -= amt
    else:
        print("Insufficient balance")

print("Current Balance:", balance)
