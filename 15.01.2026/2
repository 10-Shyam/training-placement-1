class VowelCount {
    public static void main(String args[]) {
        String s = "education";
        int count = 0;

        for(int i=0;i<s.length();i++) {
            char c = s.charAt(i);
            if("aeiou".indexOf(c) != -1)
                count++;
        }

        System.out.println("Vowels = " + count);
    }
}
